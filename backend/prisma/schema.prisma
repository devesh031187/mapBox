// Hotel F&B Inventory Management System — Prisma schema (single source of DB truth)
//
// Design note: domain hierarchies (header→lines, category trees, vendor↔item,
// procurement chain) use explicit Prisma @relation. Actor/audit foreign keys
// (created_by, approved_by, posted_by, requested_by, updated_by, etc.) are stored
// as plain UUID scalar columns rather than formal Prisma relations — otherwise the
// User model would need ~60 back-relation fields, which is unmaintainable.
// Referential integrity for those columns is enforced at the DB layer via SQL in
// migrations. This is deliberate and documented in TECHNICAL_SPECIFICATION.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  STORE_MANAGER
  FB_MANAGER
  FINANCE
  GM_DIRECTOR
}

enum ItemStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum Uom {
  KG
  G
  LTR
  ML
  PCS
  DZ
  BOX
  CAN
  BTL
  PKT
  BG
  ROLL
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
  UNDER_REVIEW
}

enum PrStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  CONVERTED_TO_RFQ
  CLOSED
}

enum RfqStatus {
  DRAFT
  SENT
  PARTIAL_RESPONSE
  FULLY_RESPONDED
  COMPARATIVE_DONE
  CLOSED
}

enum QuotationStatus {
  RECEIVED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

enum PoStatus {
  DRAFT
  APPROVED
  SENT_TO_VENDOR
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CLOSED
  CANCELLED
}

enum GrnStatus {
  DRAFT
  POSTED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
}

enum ApprovalDocumentType {
  PURCHASE_REQUISITION
  PURCHASE_ORDER
  GRN
  WASTAGE
  PAYMENT
  RATE_CONTRACT
}

enum PriceAlertType {
  SPIKE
  DROP
  THRESHOLD_BREACH
}

enum PaymentTerms {
  IMMEDIATE
  NET_7
  NET_15
  NET_30
  NET_45
  NET_60
  COD
}

enum StorageZone {
  DRY_STORE
  COLD_ROOM
  FREEZER
  BAR_STORE
  KITCHEN
  HOUSEKEEPING
  GENERAL
}

enum IssuanceStatus {
  DRAFT
  REQUESTED
  APPROVED
  PARTIALLY_ISSUED
  ISSUED
  CANCELLED
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  PARTIALLY_RECEIVED
  CANCELLED
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  COUNTED
  VARIANCE_REVIEW
  APPROVED
  POSTED
  CANCELLED
}

enum StockCountType {
  FULL
  CYCLE
  SPOT
  CATEGORY
}

enum WastageStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  POSTED
}

enum WastageReason {
  EXPIRED
  SPOILED
  DAMAGED
  BREAKAGE
  OVER_PRODUCTION
  CONTAMINATION
  PEST
  OTHER
}

enum InvoiceStatus {
  RECEIVED
  UNDER_VERIFICATION
  MATCHED
  MISMATCH_HOLD
  APPROVED
  PARTIALLY_PAID
  PAID
  DISPUTED
  CANCELLED
}

enum MatchStatus {
  NOT_MATCHED
  MATCHED
  PRICE_VARIANCE
  QTY_VARIANCE
  BOTH_VARIANCE
}

enum PaymentStatus {
  SCHEDULED
  PENDING_APPROVAL
  APPROVED
  PROCESSED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CHEQUE
  CASH
  UPI
  CARD
  ADJUSTMENT
}

enum DebitNoteStatus {
  DRAFT
  ISSUED
  ACKNOWLEDGED
  SETTLED
  CANCELLED
}

enum DebitNoteReason {
  POST_RECEIPT_DEFECT
  SHORT_SUPPLY
  PRICE_OVERCHARGE
  QUALITY_REJECTION
  EXPIRY
  OTHER
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

enum StandingOrderFrequency {
  DAILY
  ALTERNATE_DAYS
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM_DAYS
}

enum StandingOrderStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum ExpiryAlertLevel {
  NEAR_EXPIRY
  EXPIRED
  CRITICAL
}

enum NotificationType {
  APPROVAL_PENDING
  APPROVAL_RESULT
  PRICE_ALERT
  EXPIRY_ALERT
  REORDER_ALERT
  GRN_POSTED
  PAYMENT_DUE
  CONTRACT_EXPIRING
  STOCK_COUNT_DUE
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  BOTH
}

enum PoRevisionStatus {
  ORIGINAL
  AMENDED
  SUPERSEDED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  APPROVE
  REJECT
  POST
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
}

enum BatchStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  QUARANTINED
}

enum PoSourceType {
  MANUAL
  FROM_CS
  FROM_STANDING_ORDER
  FROM_CONTRACT
}

// ============================================================
// CORE / IDENTITY
// ============================================================

model Outlet {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(100)
  code      String   @unique @db.VarChar(20)
  type      String   @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  users                 User[]
  storageLocations      StorageLocation[]
  purchaseRequisitions  PurchaseRequisition[]
  purchaseOrders        PurchaseOrder[]

  @@map("outlets")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeCode String    @unique @map("employee_code") @db.VarChar(20)
  fullName     String    @map("full_name") @db.VarChar(100)
  email        String    @unique @db.VarChar(150)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole
  outletId     String?   @map("outlet_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  outlet Outlet? @relation(fields: [outletId], references: [id])

  @@index([role])
  @@map("users")
}

model RevokedToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jti       String   @unique @db.VarChar(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("revoked_tokens")
}

// ============================================================
// MASTER INVENTORY
// ============================================================

model ItemCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(20)
  parentId    String?  @map("parent_id") @db.Uuid
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  parent   ItemCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ItemCategory[] @relation("CategoryTree")
  items    Item[]

  @@index([parentId])
  @@map("item_categories")
}

model StorageLocation {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String      @db.VarChar(100)
  code                String      @unique @db.VarChar(20)
  zone                StorageZone
  outletId            String?     @map("outlet_id") @db.Uuid
  temperatureMinC     Decimal?    @map("temperature_min_c") @db.Decimal(5, 2)
  temperatureMaxC     Decimal?    @map("temperature_max_c") @db.Decimal(5, 2)
  capacityDescription String?     @map("capacity_description")
  isActive            Boolean     @default(true) @map("is_active")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz

  outlet Outlet? @relation(fields: [outletId], references: [id])
  items  Item[]

  @@map("storage_locations")
}

model Item {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemCode          String     @unique @map("item_code") @db.VarChar(30)
  name              String     @db.VarChar(200)
  description       String?
  categoryId        String     @map("category_id") @db.Uuid
  primaryUom        Uom        @map("primary_uom")
  secondaryUom      Uom?       @map("secondary_uom")
  conversionFactor  Decimal?   @map("conversion_factor") @db.Decimal(10, 4)
  storageLocationId String     @map("storage_location_id") @db.Uuid
  parLevelMin       Decimal    @default(0) @map("par_level_min") @db.Decimal(12, 3)
  parLevelMax       Decimal    @default(0) @map("par_level_max") @db.Decimal(12, 3)
  reorderPoint      Decimal    @default(0) @map("reorder_point") @db.Decimal(12, 3)
  reorderQty        Decimal    @default(0) @map("reorder_qty") @db.Decimal(12, 3)
  currentStock      Decimal    @default(0) @map("current_stock") @db.Decimal(12, 3)
  averageCost       Decimal    @default(0) @map("average_cost") @db.Decimal(12, 4)
  lastPurchasePrice Decimal?   @map("last_purchase_price") @db.Decimal(12, 4)
  isPerishable      Boolean    @default(false) @map("is_perishable")
  shelfLifeDays     Int?       @map("shelf_life_days")
  hsnCode           String?    @map("hsn_code") @db.VarChar(20)
  taxRatePercent    Decimal    @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)
  status            ItemStatus @default(ACTIVE)
  imageUrl          String?    @map("image_url") @db.VarChar(500)
  trackBatches      Boolean    @default(false) @map("track_batches")
  trackExpiry       Boolean    @default(false) @map("track_expiry")
  nearExpiryDays    Int?       @map("near_expiry_days")
  barcode           String?    @db.VarChar(64)
  abcClass          String?    @map("abc_class") @db.Char(1)
  createdBy         String     @map("created_by") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  category        ItemCategory    @relation(fields: [categoryId], references: [id])
  storageLocation StorageLocation @relation(fields: [storageLocationId], references: [id])

  stockLedger        ItemStockLedger[]
  vendorMappings     VendorItemMapping[]
  prItems            PurchaseRequisitionItem[]
  rfqItems           RfqItem[]
  quotationLines     QuotationLineItem[]
  csLineSelections   CsLineSelection[]
  poItems            PurchaseOrderItem[]
  grnItems           GrnItem[]
  priceHistory       PriceHistory[]
  priceAlerts        PriceAlert[]
  batches            ItemBatch[]
  issuanceItems      StockIssuanceItem[]
  transferItems      StockTransferItem[]
  countItems         StockCountItem[]
  wastageItems       WastageItem[]
  rateContractItems  RateContractItem[]
  standingOrderItems StandingOrderItem[]
  recipeIngredients  RecipeIngredient[]

  @@index([categoryId])
  @@index([status])
  @@index([storageLocationId])
  @@index([barcode])
  @@map("items")
}

model ItemStockLedger {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId        String   @map("item_id") @db.Uuid
  batchId       String?  @map("batch_id") @db.Uuid
  movementType  String   @map("movement_type") @db.VarChar(30)
  referenceId   String?  @map("reference_id") @db.Uuid
  referenceCode String?  @map("reference_code") @db.VarChar(50)
  qtyIn         Decimal  @default(0) @map("qty_in") @db.Decimal(12, 3)
  qtyOut        Decimal  @default(0) @map("qty_out") @db.Decimal(12, 3)
  unitCost      Decimal  @map("unit_cost") @db.Decimal(12, 4)
  balanceQty    Decimal  @map("balance_qty") @db.Decimal(12, 3)
  balanceValue  Decimal  @map("balance_value") @db.Decimal(14, 4)
  remarks       String?
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  item  Item       @relation(fields: [itemId], references: [id])
  batch ItemBatch? @relation(fields: [batchId], references: [id])

  @@index([itemId, createdAt])
  @@map("item_stock_ledger")
}

// ============================================================
// VENDOR MANAGEMENT
// ============================================================

model VendorCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(20)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  vendors Vendor[]

  @@map("vendor_categories")
}

model Vendor {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorCode         String       @unique @map("vendor_code") @db.VarChar(30)
  companyName        String       @map("company_name") @db.VarChar(200)
  tradeName          String?      @map("trade_name") @db.VarChar(200)
  vendorCategoryId   String       @map("vendor_category_id") @db.Uuid
  contactPerson      String       @map("contact_person") @db.VarChar(100)
  email              String       @db.VarChar(150)
  phone              String       @db.VarChar(20)
  alternatePhone     String?      @map("alternate_phone") @db.VarChar(20)
  addressLine1       String       @map("address_line1") @db.VarChar(200)
  addressLine2       String?      @map("address_line2") @db.VarChar(200)
  city               String       @db.VarChar(100)
  state              String       @db.VarChar(100)
  pincode            String       @db.VarChar(10)
  country            String       @default("India") @db.VarChar(100)
  taxId              String?      @map("tax_id") @db.VarChar(50)
  paymentTerms       PaymentTerms @default(NET_30) @map("payment_terms")
  creditLimit        Decimal?     @map("credit_limit") @db.Decimal(14, 2)
  bankName           String?      @map("bank_name") @db.VarChar(100)
  bankAccountNo      String?      @map("bank_account_no") @db.VarChar(50)
  bankIfsc           String?      @map("bank_ifsc") @db.VarChar(20)
  bankBranch         String?      @map("bank_branch") @db.VarChar(100)
  status             VendorStatus @default(ACTIVE)
  blacklistReason    String?      @map("blacklist_reason")
  rating             Decimal?     @db.Decimal(3, 2)
  onTimeDeliveryRate Decimal?     @map("on_time_delivery_rate") @db.Decimal(5, 2)
  qualityScore       Decimal?     @map("quality_score") @db.Decimal(5, 2)
  notes              String?
  createdBy          String       @map("created_by") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  vendorCategory     VendorCategory              @relation(fields: [vendorCategoryId], references: [id])
  itemMappings       VendorItemMapping[]
  rfqVendors         RfqVendor[]
  quotations         Quotation[]
  purchaseOrders     PurchaseOrder[]
  grns               Grn[]
  performanceRecords VendorPerformanceRecord[]
  rankingScores      VendorRankingScore[]
  priceHistory       PriceHistory[]
  invoices           VendorInvoice[]
  payments           Payment[]
  debitNotes         DebitNote[]
  rateContracts      RateContract[]
  standingOrders     StandingOrder[]

  @@map("vendors")
}

model VendorItemMapping {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId              String   @map("vendor_id") @db.Uuid
  itemId                String   @map("item_id") @db.Uuid
  vendorItemCode        String?  @map("vendor_item_code") @db.VarChar(50)
  vendorItemDescription String?  @map("vendor_item_description") @db.VarChar(200)
  leadTimeDays          Int      @default(1) @map("lead_time_days")
  minimumOrderQty       Decimal? @map("minimum_order_qty") @db.Decimal(12, 3)
  isPreferred           Boolean  @default(false) @map("is_preferred")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  vendor Vendor @relation(fields: [vendorId], references: [id])
  item   Item   @relation(fields: [itemId], references: [id])

  @@unique([vendorId, itemId])
  @@map("vendor_item_mapping")
}

model VendorPerformanceRecord {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId             String    @map("vendor_id") @db.Uuid
  poId                 String?   @map("po_id") @db.Uuid
  grnId                String?   @map("grn_id") @db.Uuid
  promisedDeliveryDate DateTime  @map("promised_delivery_date") @db.Date
  actualDeliveryDate   DateTime? @map("actual_delivery_date") @db.Date
  onTime               Boolean?  @map("on_time")
  delayDays            Int?      @map("delay_days")
  orderedQty           Decimal   @map("ordered_qty") @db.Decimal(12, 3)
  receivedQty          Decimal?  @map("received_qty") @db.Decimal(12, 3)
  rejectedQty          Decimal   @default(0) @map("rejected_qty") @db.Decimal(12, 3)
  qualityPassRate      Decimal?  @map("quality_pass_rate") @db.Decimal(5, 2)
  priceVariancePercent Decimal?  @map("price_variance_percent") @db.Decimal(6, 3)
  rfqResponseTimeHours Decimal?  @map("rfq_response_time_hours") @db.Decimal(8, 2)
  notes                String?
  recordedAt           DateTime  @default(now()) @map("recorded_at") @db.Timestamptz

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@map("vendor_performance_records")
}

// ============================================================
// APPROVAL WORKFLOW
// ============================================================

model ApprovalTier {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentType ApprovalDocumentType @map("document_type")
  tierName     String               @map("tier_name") @db.VarChar(50)
  tierOrder    Int                  @map("tier_order")
  minValue     Decimal              @map("min_value") @db.Decimal(14, 2)
  maxValue     Decimal?             @map("max_value") @db.Decimal(14, 2)
  requiredRole UserRole             @map("required_role")
  isActive     Boolean              @default(true) @map("is_active")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  approvalRecords ApprovalRecord[]

  @@unique([documentType, tierOrder])
  @@map("approval_tiers")
}

model ApprovalRecord {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentType   ApprovalDocumentType @map("document_type")
  documentId     String               @map("document_id") @db.Uuid
  documentNumber String               @map("document_number") @db.VarChar(30)
  tierId         String               @map("tier_id") @db.Uuid
  tierOrder      Int                  @map("tier_order")
  approverId     String               @map("approver_id") @db.Uuid
  status         ApprovalStatus       @default(PENDING)
  actionAt       DateTime?            @map("action_at") @db.Timestamptz
  comments       String?
  escalatedTo    String?              @map("escalated_to") @db.Uuid
  escalatedAt    DateTime?            @map("escalated_at") @db.Timestamptz
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz

  tier ApprovalTier @relation(fields: [tierId], references: [id])

  @@index([documentType, documentId])
  @@index([approverId, status])
  @@map("approval_records")
}

model ApprovalDelegation {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  delegatorId  String                 @map("delegator_id") @db.Uuid
  delegateId   String                 @map("delegate_id") @db.Uuid
  documentTypes ApprovalDocumentType[] @map("document_types")
  startDate    DateTime               @map("start_date") @db.Date
  endDate      DateTime               @map("end_date") @db.Date
  reason       String?
  isActive     Boolean                @default(true) @map("is_active")
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz

  @@map("approval_delegations")
}

// ============================================================
// PROCUREMENT FLOW
// ============================================================

model PurchaseRequisition {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prNumber             String   @unique @map("pr_number") @db.VarChar(30)
  title                String   @db.VarChar(200)
  requestedBy          String   @map("requested_by") @db.Uuid
  outletId             String?  @map("outlet_id") @db.Uuid
  requiredDate         DateTime @map("required_date") @db.Date
  priority             String   @default("NORMAL") @db.VarChar(20)
  totalEstimatedValue  Decimal  @default(0) @map("total_estimated_value") @db.Decimal(14, 2)
  status               PrStatus @default(DRAFT)
  remarks              String?
  currentApprovalTier  Int?     @map("current_approval_tier")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  outlet Outlet?                   @relation(fields: [outletId], references: [id])
  items  PurchaseRequisitionItem[]
  rfqs   RequestForQuotation[]
  pos    PurchaseOrder[]

  @@map("purchase_requisitions")
}

model PurchaseRequisitionItem {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prId                String   @map("pr_id") @db.Uuid
  itemId              String   @map("item_id") @db.Uuid
  requiredQty         Decimal  @map("required_qty") @db.Decimal(12, 3)
  uom                 Uom
  estimatedUnitPrice  Decimal? @map("estimated_unit_price") @db.Decimal(12, 4)
  estimatedTotal      Decimal? @map("estimated_total") @db.Decimal(14, 2)
  currentStock        Decimal? @map("current_stock") @db.Decimal(12, 3)
  justification       String?
  lineStatus          String   @default("PENDING") @map("line_status") @db.VarChar(20)

  pr      PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)
  item    Item                @relation(fields: [itemId], references: [id])
  rfqItems RfqItem[]

  @@map("purchase_requisition_items")
}

model RequestForQuotation {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rfqNumber          String    @unique @map("rfq_number") @db.VarChar(30)
  prId               String?   @map("pr_id") @db.Uuid
  title              String    @db.VarChar(200)
  issuedBy           String    @map("issued_by") @db.Uuid
  issueDate          DateTime  @default(now()) @map("issue_date") @db.Date
  responseDeadline   DateTime  @map("response_deadline") @db.Date
  deliveryRequiredBy DateTime  @map("delivery_required_by") @db.Date
  status             RfqStatus @default(DRAFT)
  termsAndConditions String?   @map("terms_and_conditions")
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  pr                   PurchaseRequisition?  @relation(fields: [prId], references: [id])
  items                RfqItem[]
  rfqVendors           RfqVendor[]
  quotations           Quotation[]
  comparativeStatement ComparativeStatement?
  purchaseOrders       PurchaseOrder[]

  @@map("request_for_quotations")
}

model RfqItem {
